{
  "name": "pixel-offspring",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/migrate.ts",
    "preview": "next start --hostname 127.0.0.1 --port 4173",
    "check": "pnpm source:check && pnpm typecheck && pnpm test:coverage && pnpm build",
    "measure": "node scripts/measure.mjs",
    "assets:check": "python3 scripts/check-assets.py && python3 scripts/check-fusions.py",
    "test:coverage": "vitest run --coverage",
    "source:check": "node scripts/check-source.mjs",
    "start": "next start --hostname 127.0.0.1 --port 5173"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "next": "^16.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.14.0"
}
